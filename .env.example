# Required
ANTHROPIC_API_KEY=sk-ant-...
HUB_BOOTSTRAP_KEY=your-generated-key
PORT=4000

# Deployment (local dev needs neither — CONVEX_URL defaults to http://127.0.0.1:3210)
CONVEX_URL=http://convex:3210
HUB_URL=https://hub.tarrantcountymakerspace.com

# Git operations (for repo-fixer)
GITHUB_PAT=ghp_...
REPO_URL=https://github.com/melvenac/A2A-Hub.git
REPO_PATH=/tmp/A2A-Hub

# LLM models (configurable per task)
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
REPO_FIXER_MODEL=claude-haiku-4-5-20251001

# Tuning
CONFIDENCE_THRESHOLD=0.85
